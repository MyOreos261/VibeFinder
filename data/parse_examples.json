{
  "_about": "Hand-labeled request -> preference pairs. 'train' examples are shown to Gemini as few-shot demonstrations; 'test' examples are only used to score parsers (no overlap). House conventions the examples teach: energy is set ONLY from explicit energy words (activities are left to the knowledge notes), negated genres ('anything but X') become null, and anything unclear is null.",
  "train": [
    {"request": "need some bops for the gym",
     "expected": {"genre": null, "mood": null, "energy": null, "likes_acoustic": null, "activity": "workout"}},
    {"request": "anything but country, just something chill",
     "expected": {"genre": null, "mood": "chill", "energy": null, "likes_acoustic": null, "activity": null}},
    {"request": "sad girl autumn acoustic vibes",
     "expected": {"genre": null, "mood": "sad", "energy": null, "likes_acoustic": true, "activity": null}},
    {"request": "lofi beats to study to, keep it low energy",
     "expected": {"genre": "lofi", "mood": null, "energy": 0.3, "likes_acoustic": null, "activity": "studying"}},
    {"request": "turn up!! edm for the pregame",
     "expected": {"genre": "edm", "mood": null, "energy": 0.9, "likes_acoustic": null, "activity": "party"}},
    {"request": "throwback country for cooking dinner",
     "expected": {"genre": "country", "mood": "nostalgic", "energy": null, "likes_acoustic": null, "activity": "dinner"}},
    {"request": "no electronic stuff, mellow jazz",
     "expected": {"genre": "jazz", "mood": "relaxed", "energy": null, "likes_acoustic": true, "activity": null}},
    {"request": "songs to cry to after a breakup",
     "expected": {"genre": null, "mood": "sad", "energy": null, "likes_acoustic": null, "activity": "heartbreak"}}
